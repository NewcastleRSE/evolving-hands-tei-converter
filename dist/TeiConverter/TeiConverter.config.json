{
    "useCustomBehaviours": true,
    "displayInlineGraphics": false,
    "teiFileStructure": "EvolvingHands",
    "projectRoot": "https://raw.githubusercontent.com/evolvinghands/EvolvingHandsNcl/refs/heads/main/",
    "metadataSeparate": {
        "people": "metadata/people.xml"
    },
    "facsimileCoordinates": {
        "customEvents": false,
        "elementAttribute": false
    },
    "additions": {
        "customEvents": true
    },
    "choice": {
        "abbreviations": {
            "render": "event",
            "marker": ["[", "]"],
            "useOriginal": true
        },
        "corrections": {
            "render": "event",
            "marker": ["[", "]"],
            "useOriginal": false
        }
    },
    "damage": {
        "customEvents": true
    },
    "dates": {
        "showISODate": true,
        "marker": ["[", "]"],
        "ignoreBibliography": true,
        "removeDuplicatesWorkaround": true
    },
    "deletions": {
        "render": "event",
        "marker": ["[", "]"]
    },
    "figures": {
        "placeholder": true,
        "placeholderType": "icon",
        "sizeIcon": 150,
        "descPosition": "inline",
        "showAb": true,
        "image": {
            "loadIfAvailable": false,
            "fitToContainer": true
        }
    },
    "gap": {
        "render": "event",
        "marker": "[…]"
    },
    "notes": {
        "bibliographicNotes": {
            "include": true,
            "render": "event",
            "structured": true
        },
        "editorialNotes": {
            "include": true,
            "render": "event",
            "structured": true
        }
    },
    "orgData": {
        "customEvents": true,
        "elementAttribute": false
    },
    "placeData": {
        "customEvents": true,
        "elementAttribute": false
    },
    "persData": {
        "customEvents": true,
        "elementAttribute": false
    },
    "standOffMetadata": {
        "showStandOffMetadata": false,
        "showOrgs": false,
        "showPeople": false,
        "showPlaces": false,
        "standOffPosition": "top"
    },
    "unclear": {
        "render": "event",
        "marker": ["[", "]"],
        "message": "text unclear"
    },
    "elementsSelected": {
        "ab" : {
            "include": true,
            "options": {
            }
        },
        "add": {
            "include": true
        },
        "abbr": {
            "include": true
        },
        "choice": {
            "include": true
        },
        "corr": {
            "include": true
        },
        "damage": {
            "include": true
        },
        "date": {
            "include": true
        },
        "del": {
            "include": true
        },
        "expan": {
            "include": true
        },
        "figure": {
            "include": true
        },
        "gap": {
            "include": true
        },
        "graphic" : {
            "include": true,
            "options": {
                "showLogs": false
            }
        },
        "listOrg": {
            "include": true
        },
        "listPerson": {
            "include": true
        },
        "listPlace": {
            "include": true
        },
        "note": {"include": true},
        "orgName": {
            "include": true,
            "options": {
                "addLink": "authority"
            }
        },
        "placeName": {
            "include":true,
            "options": {
                "addLink": "authority"
            }
        },
        "persName": {
            "include": true,
            "options": {
                "addLink": "false"
            }
        },
        "seg": {
            "include": true
        },
        "sic": {
            "include": true
        },
        "standOff": {
            "include": true
        },
        "unclear": {
            "include": true
        }
    },
    "addCustomBehaviours": {
        "applyCustomBehaviours": false,
        "applyAll": false,
        "applyElements" : "['persName', 'placeName', 'seg']",
        "showLogs": true
    }
}